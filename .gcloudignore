client/
node_modules/
.git
.gitignore
.gitattributes

# Env soubory: nahrává se JEN .env a .env.example. .env je produkční konfigurace (MONGODB_URI,
# GCS_BUCKET_NAME, OAuth), server ho čte přes dotenv -- bez něj appka v produkci nemá konfiguraci.
# .env.example nese jen ukázkové hodnoty, sys/health z něj pozná neznámé a chybějící klíče.
# Všechno ostatní zůstává doma: .env.development, *.local, zálohy a další .env.<cíl>.
.env*
!.env
!.env.example
*.local

# Návrh a dokumentace -- server je za běhu nečte a v public/ nejsou.
design/
docs/
dtb-design.png
README.md
todo.md

# Ikony pro kreslení BML diagramů -- peerDependency uu5bricksg01 (kvůli
# Uu5Bricks.VerticalTimeline na /historie), appka je nikde nepoužívá. 1129 souborů
# přímo v public/libs/uu_uubmldraw_iconsg04/<verze> překračuje limit GAE 1000
# souborů na adresář a deploy bez týhle výjimky rovnou spadne (design/todo.md, 5.2).
public/libs/uu_uubmldraw_iconsg04/

# Sám sebe -- gcloud ho čte lokálně, na App Engine nemá co dělat.
.gcloudignore
