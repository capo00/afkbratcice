# Předloha env souborů appky (vrstva 1: co se liší podle prostředí nebo je tajemství). Jediný env
# soubor v gitu, hodnoty jsou jen ukázkové. Skutečné soubory leží vedle něj a do gitu nepatří:
# .env.development (lokální vývoj) a .env (produkce, nahrává se s appkou na App Engine).
#
# Štítky v komentářích přímo nad klíčem (souvislý blok řádků s #, prázdný řádek ho končí) říkají,
# kde je klíč povinný; velikost písmen nehraje roli:
#   bez štítku     klíč stacku podle registru caio-serveru, vlastní klíč appky povinný všude
#   [optional]     nepovinný
#   [required]     povinný všude (s [production] jen v produkčních souborech)
#   [local]        jen .env.development, nikdy povinný -- v produkčním souboru je chyba
#   [production]   povinný jen v produkčních souborech
# `npm run check-env` porovná env soubory s touhle předlohou a s registrem klíčů caio-serveru
# (vypisuje jen klíče, nikdy hodnoty); `npm run dev` jen upozorní, `npm run deploy` se zastaví.
#
# Co v env souborech není: platnost přihlášení (server/server.config.js `auth.jwtLifetime`, dřív
# JWT_LIFETIME) a odchozí pošta (Nastavení v administraci, dřív SMTP_* a MAIL_FROM).

# --- Server ---
# [optional] Port serveru; lokálně 8082 (vedle caio_propertyman a dalších appek), na App Engine ho
# nastavuje platforma sama.
PORT=8082
# Databáze. Lokálně vlastní databáze appky, v produkci Atlas (caio-devkit docs/mongodb-setup.md).
MONGODB_URI=mongodb://127.0.0.1:27017/afkbratcice
# Klíč pro podepisování přihlašovacích tokenů. V produkci silný a jiný než lokálně.
JWT_SECRET=change-me-at-least-32-characters-long
# [production] Veřejná adresa webu bez lomítka na konci: sitemap.xml, robots.txt, canonical, og:image.
APP_URL=https://www.example.cz
# [optional] Hlavní host; alias (www/bez www) se na něj přesměruje. Až po přepnutí DNS.
CANONICAL_HOST=
# Klíč pro šifrování tajných hodnot Nastavení (heslo SMTP v sys_settings), 32 bajtů v base64. Bez něj
# heslo do Nastavení uložit nejde; změna klíče uložené heslo znečitelní. Vygeneruje ho
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# [optional]
SETTINGS_SECRET_KEY=

# --- Přihlášení (caio-devkit docs/login.md) ---
# Prázdné = tlačítko daného provideru se nenabídne, zůstává e-mail a heslo.
# [optional]
GOOGLE_CLIENT_ID=
# [optional]
GOOGLE_CLIENT_SECRET=
# [optional]
FACEBOOK_APP_ID=
# [optional]
FACEBOOK_APP_SECRET=

# --- Soubory (caio-devkit docs/how-to-set-gcs.md) ---
# Bucket pro erby, fotky a soubory ke stažení; bez něj se binary/* use casy nezapnou a administrace
# nic nenahraje. Lokálně a v produkci každý svůj (afkbratcice-binary-dev / afkbratcice-binary).
# [required]
GCS_BUCKET_NAME=example-binary-dev

# --- Jen lokálně ---
# [local] [optional] Port Vite dev serveru (dřív VITE_PORT v client/.env.development); `npm run dev`
# ho nepoužívá.
CLIENT_PORT=3002
# Testovací účty pro QA v prohlížeči (`npm run qa-accounts`, jen proti lokální databázi): každé
# QA_<JMÉNO>_EMAIL je jeden účet s heslem a rolemi (čárkami; ADMIN bez ROLES dostane authorities).
# Heslo si zvol sám, sem nepatří.
# [local] [optional]
QA_ADMIN_EMAIL=qa-admin@afkbratcice.test
# [local] [optional]
QA_ADMIN_PASSWORD=
# Editor jednoho mužstva: teamEditor:<id týmu> (rozsahová role).
# [local] [optional]
QA_TEAMEDITOR_EMAIL=qa-team@afkbratcice.test
# [local] [optional]
QA_TEAMEDITOR_PASSWORD=
# [local] [optional]
QA_TEAMEDITOR_ROLES=teamEditor:000000000000000000000000
